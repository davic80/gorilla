# Red Docker del Caddy compartido. Se averigua con:
#   docker inspect cloud-caddy-1 \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=cloud_default

# Versión de la imagen. `latest` sigue a main; pon un SHA para fijar o volver
# atrás sin reconstruir nada.
GORILLA_TAG=latest
